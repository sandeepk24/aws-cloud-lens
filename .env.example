# -----------------------------------------------------------------------------
# AWS CloudLens — environment template
# Copy to .env and adjust values for local development.
# -----------------------------------------------------------------------------

# Application
APP_NAME=cloudlens-api
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://cloudlens:cloudlens@localhost:5432/cloudlens
# For local SQLite without Postgres:
# DATABASE_URL=sqlite+pysqlite:///./data/cloudlens.db

# External accounts configuration (required for connectors / collectors)
# Copy config/accounts.example.yaml → config/accounts.yaml (gitignored), then:
CLOUDLENS_CONFIG_PATH=./config/accounts.yaml
# Do not put account IDs, role ARNs, profiles, or regions in this file —
# they belong only in the YAML referenced above.

# Private output folder for diagram exports (python -m app.discovery export).
# Files go to <dir>/<project>/<account_id>/ with owner-only permissions.
CLOUDLENS_EXPORT_DIR=./data/exports

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
